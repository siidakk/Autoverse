# Dependencies and generated builds
node_modules/
dist/
coverage/

# Environment files and secrets
.env
.env.*
!.env.example

# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Logs and operating-system/editor files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Uncompressed model backups kept locally, not in the repo
*.orig.glb

# Local database files
backend/.data/

# CarDD and anything cut from it. The dataset is licensed for non-commercial
# research and education, and its images are Flickr and Shutterstock content
# that the dataset does not own. None of it is redistributed from here.
ml/data/
ml/damage/
ml/bodystyle/

# Deck QA renders, regenerated from the pptx whenever they are needed
docs/render/
docs/*.pdf

# Office lock files, left behind while a document is open
~$*

# Intermediate output of build_catalogue.py run on its own. The real
# artefacts are recommender.pkl and price_model.pkl.
ml/catalogue_new.pkl

# Scratch photo used to drive the photo pages end to end during development.
# Not part of the site.
frontend/public/__test-car.png
frontend/public/__test-car-small.jpg
