# Where the database lives.
#
# Locally, start.bat runs one on this machine and keeps its data in
# backend/.data, so accounts and saved builds survive a restart:
MONGO_URI=mongodb://127.0.0.1:27019/autoverse
#
# In production this should be an Atlas connection string instead. Create a
# free cluster at mongodb.com/atlas, add a database user, allow access from
# anywhere under Network Access, then paste the string it gives you and put
# the password in place of <password>:
# MONGO_URI=mongodb+srv://user:<password>@yourcluster.mongodb.net/autoverse

# Signs session tokens. Any long random string. The API refuses to start in
# production without one rather than falling back to something guessable.
JWT_SECRET=change-me-to-something-long-and-random

# Where the recommendation service is. Left unset it assumes 127.0.0.1:8000.
# ML_API_URL=https://autoverse-ml.onrender.com
