# URL of the deployed Flask ML service. Do not add a trailing slash.
ML_API_URL=http://127.0.0.1:8000

# Render populates this automatically from the ML service. Do not set it locally.
# ML_API_HOSTPORT=autoverse-ml:10000

# Optional: MongoDB is not used by the current application routes.
# MONGO_URI=mongodb+srv://...

# Optional local development port.
PORT=5000
