# Public URL of the Express API. No trailing slash.
# Local: http://localhost:5000
VITE_API_URL=http://localhost:5000

# Public URL of the Python recommendation service. No trailing slash.
# Recommendations go through the API above, and fall back to this if the API
# cannot be reached, so a sleeping or suspended proxy does not take the feature
# down with it.
# Local: http://localhost:8000
VITE_ML_URL=http://localhost:8000
